{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "navy": "#0a1628",
    "navyPanel": "#081422",
    "navyDeep": "#070f1c",
    "navyEdge": "#050c16",
    "lime": "#5ce65c",
    "limeBright": "#7ef47e",
    "limeSoft": "#8fe89f",
    "limePale": "#9ef5ae",
    "mint": "#a8e8b8",
    "sage": "#9fdfaf",
    "moss": "#4a9c62",
    "mossDim": "#3d9a3d",
    "coral": "#ff6b6b",
    "coralPink": "#ff5c7a",
    "coralPale": "#ff9f9f",
    "red": "#ff4444",
    "amber": "#ffc46b",
    "border": "#2a4a38",
    "borderBright": "#4a9c5c",
    "diffAddBg": "#11301f",
    "diffDelBg": "#3a1620",
    "paper": "#f4f8f5",
    "paperPanel": "#e7efe9",
    "ink": "#0a1628",
    "inkMuted": "#41614f",
    "limeInk": "#1b7f3a",
    "coralInk": "#c2344b"
  },
  "theme": {
    "primary": { "dark": "lime", "light": "limeInk" },
    "secondary": { "dark": "limeSoft", "light": "limeInk" },
    "accent": { "dark": "coral", "light": "coralInk" },
    "error": { "dark": "red", "light": "coralInk" },
    "warning": { "dark": "amber", "light": "#9a6b00" },
    "success": { "dark": "limeBright", "light": "limeInk" },
    "info": { "dark": "mint", "light": "inkMuted" },
    "text": { "dark": "mint", "light": "ink" },
    "textMuted": { "dark": "moss", "light": "inkMuted" },
    "background": { "dark": "navy", "light": "paper" },
    "backgroundPanel": { "dark": "navyPanel", "light": "paperPanel" },
    "backgroundElement": { "dark": "navyDeep", "light": "paperPanel" },
    "border": { "dark": "border", "light": "#c9d8ce" },
    "borderActive": { "dark": "borderBright", "light": "limeInk" },
    "borderSubtle": { "dark": "navyEdge", "light": "#d9e5dd" },
    "diffAdded": { "dark": "limeBright", "light": "limeInk" },
    "diffRemoved": { "dark": "coral", "light": "coralInk" },
    "diffContext": { "dark": "moss", "light": "inkMuted" },
    "diffHunkHeader": { "dark": "sage", "light": "inkMuted" },
    "diffHighlightAdded": { "dark": "limeBright", "light": "limeInk" },
    "diffHighlightRemoved": { "dark": "coralPale", "light": "coralInk" },
    "diffAddedBg": { "dark": "diffAddBg", "light": "#dcefe1" },
    "diffRemovedBg": { "dark": "diffDelBg", "light": "#f7dde1" },
    "diffContextBg": { "dark": "navyPanel", "light": "paperPanel" },
    "diffLineNumber": { "dark": "border", "light": "#c9d8ce" },
    "diffAddedLineNumberBg": { "dark": "diffAddBg", "light": "#dcefe1" },
    "diffRemovedLineNumberBg": { "dark": "diffDelBg", "light": "#f7dde1" },
    "markdownText": { "dark": "mint", "light": "ink" },
    "markdownHeading": { "dark": "limeBright", "light": "limeInk" },
    "markdownLink": { "dark": "coralPink", "light": "coralInk" },
    "markdownLinkText": { "dark": "limeSoft", "light": "limeInk" },
    "markdownCode": { "dark": "limeBright", "light": "limeInk" },
    "markdownBlockQuote": { "dark": "moss", "light": "inkMuted" },
    "markdownEmph": { "dark": "coralPale", "light": "coralInk" },
    "markdownStrong": { "dark": "limeBright", "light": "limeInk" },
    "markdownHorizontalRule": { "dark": "border", "light": "#c9d8ce" },
    "markdownListItem": { "dark": "lime", "light": "limeInk" },
    "markdownListEnumeration": { "dark": "sage", "light": "inkMuted" },
    "markdownImage": { "dark": "coralPink", "light": "coralInk" },
    "markdownImageText": { "dark": "limeSoft", "light": "limeInk" },
    "markdownCodeBlock": { "dark": "mint", "light": "ink" },
    "syntaxComment": { "dark": "moss", "light": "inkMuted" },
    "syntaxKeyword": { "dark": "limeSoft", "light": "limeInk" },
    "syntaxFunction": { "dark": "#8fef9f", "light": "limeInk" },
    "syntaxVariable": { "dark": "limePale", "light": "ink" },
    "syntaxString": { "dark": "limeBright", "light": "limeInk" },
    "syntaxNumber": { "dark": "coralPale", "light": "coralInk" },
    "syntaxType": { "dark": "#7ed9a0", "light": "limeInk" },
    "syntaxOperator": { "dark": "sage", "light": "inkMuted" },
    "syntaxPunctuation": { "dark": "sage", "light": "ink" }
  }
}
